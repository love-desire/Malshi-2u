<script>

/* =====================================
   FLOATING HEARTS
===================================== */

const hearts = [

    "❤️",
    "💕",
    "💗",
    "💖",
    "💓",
    "💞",
    "🌹",
    "✨"

];

function createHeart() {

    const heart =
        document.createElement("div");

    heart.className =
        "floating-heart";

    heart.innerHTML =
        hearts[
            Math.floor(
                Math.random()
                *
                hearts.length
            )
        ];

    heart.style.left =
        Math.random()
        *
        100
        +
        "vw";

    heart.style.fontSize =
        (
            18
            +
            Math.random()
            *
            25
        )
        +
        "px";

    heart.style.animationDuration =
        (
            4
            +
            Math.random()
            *
            5
        )
        +
        "s";

    document.body.appendChild(
        heart
    );

    setTimeout(() => {

        heart.remove();

    }, 9000);
}

setInterval(
    createHeart,
    650
);


/* =====================================
   NEXT QUESTION
===================================== */

function next(number) {

    document
        .querySelectorAll(
            ".card > div"
        )
        .forEach(page => {

            page.classList.add(
                "hidden"
            );

        });

    document
        .getElementById(
            "q" + number
        )
        .classList.remove(
            "hidden"
        );
}


/* =====================================
   NEGATIVE ANSWERS
===================================== */

const messages = {

1: [

    "WHATTT 😂🥺 I was already choosing my outfit! ❤️",

    "Imagine me waiting there with the biggest smile. 🥹",

    "No pressure... I just really want a lovely time with you. ❤️"

],

2: [

    "No rose?! 😭 Am I supposed to arrive with a potato? 😂",

    "Okay fineee... but I'm still bringing my best smile. 😌❤️",

    "One tiny rose for my favourite person? 🌹🥹"

],

3: [

    "Maybe? 👀 That's suspiciously close to YES 😂",

    "I'll wait patiently for permission. 🫂❤️",

    "Only if you're comfortable, promise. ❤️"

],

4: [

    "My hand is already feeling lonely 😂🤝",

    "Okay okay, I'll behave! 😇",

    "Only if you're comfortable. ❤️"

],

5: [

    "Shyyy? 😂 Don't worry, I'll smile at the camera too. 🙈",

    "One tiny memory for us? 🥹📸",

    "No pressure — just imagine how cute it could be. ❤️"

],

6: [

    "Okay okay 😂 I'll wait patiently. 👀❤️",

    "No pressure — only if you genuinely want to. 🥹",

    "But I bet that question made you smile a little. 😏❤️"

],

7: [

    "Obviously? 😂 Then why did you click NO?!",

    "Okay okay, you win 😂❤️",

    "Let's make beautiful memories together. 🥹🌹"

]

};


let attempts = {};


function negative(question) {

    if (!attempts[question]) {

        attempts[question] = 0;

    }

    attempts[question]++;

    const list =
        messages[question];

    const index =
        Math.min(
            attempts[question] - 1,
            2
        );

    document
        .getElementById(
            "m" + question
        )
        .innerHTML =
        list[index];


    if (
        attempts[question] >= 3
    ) {

        document
            .getElementById(
                "m" + question
            )
            .innerHTML +=

            "<br><br>" +

            "<button class='yes' " +

            "onclick='continueGame(" +

            question +

            ")'>" +

            "Okayyy, continue ❤️" +

            "</button>";
    }
}


/* =====================================
   CONTINUE
===================================== */

function continueGame(question) {

    if (question === 7) {

        finish();

    } else {

        next(
            question + 1
        );

    }
}


/* =====================================
   ROSE PETALS
===================================== */

function createPetal() {

    const petal =
        document.createElement("div");

    petal.className =
        "petal";

    petal.innerHTML =
        "🌹";

    petal.style.left =
        Math.random()
        *
        100
        +
        "vw";

    petal.style.fontSize =
        (
            15
            +
            Math.random()
            *
            22
        )
        +
        "px";

    petal.style.animationDuration =
        (
            5
            +
            Math.random()
            *
            5
        )
        +
        "s";

    document.body.appendChild(
        petal
    );

    setTimeout(() => {

        petal.remove();

    }, 10000);
}


/* =====================================
   SPARKLES
===================================== */

function createSparkle() {

    const sparkle =
        document.createElement("div");

    sparkle.className =
        "sparkle";

    sparkle.innerHTML =
        "✨";

    sparkle.style.left =
        Math.random()
        *
        100
        +
        "vw";

    sparkle.style.top =
        Math.random()
        *
        100
        +
        "vh";

    sparkle.style.fontSize =
        (
            10
            +
            Math.random()
            *
            18
        )
        +
        "px";

    document.body.appendChild(
        sparkle
    );

    setTimeout(() => {

        sparkle.remove();

    }, 2000);
}


/* =====================================
   FINAL PAGE
===================================== */

function finish() {

    document
        .querySelectorAll(
            ".card > div"
        )
        .forEach(page => {

            page.classList.add(
                "hidden"
            );

        });

    document
        .getElementById(
            "final"
        )
        .classList.remove(
            "hidden"
        );


    /* Dark romantic background */

    document.body.style.background =
        "#120008";


    /* Start song */

    const song =
        document.getElementById(
            "song"
        );

    song.volume = 0.5;

    song.play()
        .catch(() => {

            console.log(
                "Music autoplay was blocked by the browser."
            );

        });


    /* Heart explosion */

    for (
        let i = 0;
        i < 70;
        i++
    ) {

        setTimeout(
            createHeart,
            i * 45
        );

    }


    /* Rose shower */

    for (
        let i = 0;
        i < 35;
        i++
    ) {

        setTimeout(
            createPetal,
            i * 120
        );

    }


    /* Sparkle atmosphere */

    setInterval(
        createSparkle,
        350
    );

}

</script>

