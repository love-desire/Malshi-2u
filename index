<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>For Malshimma ❤️</title>

<style>

@import url('https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&family=Poppins:wght@400;600;700&display=swap');

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    overflow: hidden;

    font-family: Poppins, sans-serif;

    display: flex;
    justify-content: center;
    align-items: center;

    background:
        radial-gradient(circle at 15% 15%, white, transparent 25%),
        radial-gradient(circle at 85% 85%, #ffb4d2, transparent 35%),
        linear-gradient(135deg, #ffd5e6, #fff3f8, #ffc4dc);

    transition: background 2s ease;
}

.card {
    width: 92%;
    max-width: 520px;
    max-height: 92vh;

    overflow-y: auto;

    padding: 35px 22px;

    text-align: center;

    background: rgba(255,255,255,.86);

    backdrop-filter: blur(18px);

    border-radius: 35px;

    box-shadow:
        0 25px 80px rgba(180,40,100,.2);

    z-index: 5;

    animation: appear .7s ease;
}

.hidden {
    display: none;
}

.emoji {
    font-size: 58px;

    animation:
        bounce 1.5s infinite;
}

.number {
    color: #aaa;

    font-size: 12px;

    letter-spacing: 2px;
}

h1 {
    font-family: 'Dancing Script', cursive;

    font-size: 46px;

    color: #d91b62;

    margin: 12px 0;
}

h2 {
    color: #d91b62;

    font-size: 20px;

    line-height: 1.55;
}

p {
    color: #666;

    font-size: 16px;

    line-height: 1.7;
}

.buttons {
    display: flex;

    justify-content: center;

    flex-wrap: wrap;

    gap: 12px;

    margin-top: 25px;
}

button {
    border: none;

    padding: 13px 23px;

    border-radius: 50px;

    font-family: Poppins;

    font-size: 15px;

    font-weight: 600;

    cursor: pointer;

    transition: .3s;
}

.yes {
    background:
        linear-gradient(135deg,#ff4381,#d91b62);

    color: white;

    box-shadow:
        0 9px 23px rgba(217,27,98,.3);
}

.yes:hover {
    transform: scale(1.07);
}

.no {
    background: white;

    color: #777;

    box-shadow:
        0 7px 20px rgba(0,0,0,.1);
}

.no:hover {
    transform: scale(.96);
}

.message {
    min-height: 65px;

    margin-top: 20px;

    color: #d91b62;

    font-size: 14px;

    font-weight: 600;

    line-height: 1.7;
}


/* =====================================
   CINEMATIC FINAL PAGE
===================================== */

#final {

    position: relative;

    min-height: 520px;

    display: flex;

    flex-direction: column;

    justify-content: center;

    align-items: center;

    overflow: hidden;

    animation:
        finalReveal 2s ease forwards;
}

.final-bg {

    position: fixed;

    inset: 0;

    background:
        radial-gradient(
            circle at center,
            rgba(255,80,145,.28),
            transparent 30%
        ),

        linear-gradient(
            135deg,
            #18000d,
            #3a001f,
            #120008
        );

    opacity: 0;

    pointer-events: none;

    animation:
        backgroundReveal 3s ease forwards;

    z-index: -2;
}

.glow {

    position: absolute;

    width: 280px;
    height: 280px;

    border-radius: 50%;

    background:
        rgba(255,70,140,.18);

    filter: blur(50px);

    animation:
        glowPulse 3s ease-in-out infinite;
}

.final-heart {

    font-size: 72px;

    opacity: 0;

    z-index: 3;

    animation:
        heartEntrance 1.5s ease forwards,
        heartbeat 1.5s 1.5s infinite;
}

.final-title {

    font-family:
        'Dancing Script', cursive;

    font-size: 58px;

    line-height: 1.05;

    color: white;

    margin: 15px 0;

    text-shadow:
        0 0 10px rgba(255,100,170,.8),
        0 0 30px rgba(255,70,150,.7),
        0 0 60px rgba(255,50,130,.5);

    opacity: 0;

    animation:
        titleReveal 2s 1s ease forwards,
        titleGlow 3s 3s infinite alternate;
}

.final-name {

    font-family:
        'Dancing Script', cursive;

    font-size: 30px;

    color: #ffb5d4;

    opacity: 0;

    animation:
        fadeUp 1.5s 2s ease forwards;
}

.final-message {

    color:
        rgba(255,255,255,.9);

    font-size: 15px;

    line-height: 1.8;

    max-width: 400px;

    opacity: 0;

    animation:
        fadeUp 1.5s 2.5s ease forwards;
}

.final-message b {
    color: #ff8fba;
}

.song-playing {

    margin-top: 12px;

    padding: 9px 18px;

    border-radius: 30px;

    background:
        rgba(255,255,255,.12);

    border:
        1px solid rgba(255,255,255,.25);

    color: #ffd2e4;

    font-size: 12px;

    backdrop-filter: blur(10px);

    opacity: 0;

    animation:
        fadeUp 1.5s 3s ease forwards,
        songPulse 2s 4s infinite;
}

.love {

    font-size: 38px;

    margin-top: 20px;

    opacity: 0;

    animation:
        fadeUp 1.5s 3.5s ease forwards,
        floatingLove 3s 5s infinite;
}


/* =====================================
   ROSE PETALS
===================================== */

.petal {

    position: fixed;

    top: -50px;

    z-index: 10;

    pointer-events: none;

    animation:
        petalFall linear forwards;
}


/* =====================================
   SPARKLES
===================================== */

.sparkle {

    position: fixed;

    pointer-events: none;

    z-index: 2;

    animation:
        sparkleAnimation 2s ease-out forwards;
}


/* =====================================
   FLOATING HEARTS
===================================== */

.floating-heart {

    position: fixed;

    bottom: -40px;

    z-index: 1;

    pointer-events: none;

    animation:
        rise linear forwards;
}


/* =====================================
   ANIMATIONS
===================================== */

@keyframes appear {

    from {
        opacity: 0;

        transform:
            translateY(25px)
            scale(.9);
    }

    to {
        opacity: 1;

        transform:
            translateY(0)
            scale(1);
    }
}

@keyframes bounce {

    0%,100% {
        transform:
            translateY(0);
    }

    50% {
        transform:
            translateY(-10px);
    }
}

@keyframes rise {

    from {

        transform:
            translateY(0)
            rotate(0);

        opacity: 0;
    }

    10% {
        opacity: 1;
    }

    to {

        transform:
            translateY(-115vh)
            rotate(360deg);

        opacity: 0;
    }
}

@keyframes finalReveal {

    from {

        opacity: 0;

        transform:
            scale(.92);
    }

    to {

        opacity: 1;

        transform:
            scale(1);
    }
}

@keyframes backgroundReveal {

    from {
        opacity: 0;
    }

    to {
        opacity: 1;
    }
}

@keyframes glowPulse {

    0%,100% {

        transform:
            scale(.85);

        opacity: .5;
    }

    50% {

        transform:
            scale(1.2);

        opacity: .9;
    }
}

@keyframes heartEntrance {

    0% {

        opacity: 0;

        transform:
            scale(.2)
            rotate(-20deg);
    }

    60% {

        opacity: 1;

        transform:
            scale(1.3)
            rotate(10deg);
    }

    100% {

        opacity: 1;

        transform:
            scale(1)
            rotate(0);
    }
}

@keyframes heartbeat {

    0%,100% {
        transform: scale(1);
    }

    15% {
        transform: scale(1.2);
    }

    30% {
        transform: scale(1);
    }

    45% {
        transform: scale(1.15);
    }

    60% {
        transform: scale(1);
    }
}

@keyframes titleReveal {

    from {

        opacity: 0;

        transform:
            translateY(30px)
            scale(.8);

        filter:
            blur(10px);
    }

    to {

        opacity: 1;

        transform:
            translateY(0)
            scale(1);

        filter:
            blur(0);
    }
}

@keyframes titleGlow {

    from {

        text-shadow:
            0 0 10px
            rgba(255,100,170,.5);
    }

    to {

        text-shadow:
            0 0 15px
            rgba(255,100,170,1),

            0 0 45px
            rgba(255,70,150,.9),

            0 0 80px
            rgba(255,50,130,.7);
    }
}

@keyframes fadeUp {

    from {

        opacity: 0;

        transform:
            translateY(25px);
    }

    to {

        opacity: 1;

        transform:
            translateY(0);
    }
}

@keyframes songPulse {

    0%,100% {

        box-shadow:
            0 0 0
            rgba(255,100,160,0);
    }

    50% {

        box-shadow:
            0 0 25px
            rgba(255,100,160,.5);
    }
}

@keyframes floatingLove {

    0%,100% {
        transform:
            translateY(0);
    }

    50% {
        transform:
            translateY(-8px);
    }
}

@keyframes petalFall {

    0% {

        transform:
            translateY(-10vh)
            rotate(0deg);

        opacity: 0;
    }

    10% {
        opacity: 1;
    }

    100% {

        transform:
            translateY(115vh)
            translateX(120px)
            rotate(540deg);

        opacity: 0;
    }
}

@keyframes sparkleAnimation {

    0% {

        transform:
            scale(0);

        opacity: 0;
    }

    30% {

        transform:
            scale(1.5);

        opacity: 1;
    }

    100% {

        transform:
            scale(0);

        opacity: 0;
    }
}

</style>
</head>


